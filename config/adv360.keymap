#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                           &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 5                                                                           &tog 7     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &tog 6    &kp LEFT_GUI  &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &tog 8     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                           &mo 5              &kp PAGE_UP                                      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL       &kp LG(ENTER)      &kp PAGE_DOWN      &kp ENTER          &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none    &none       &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &trans                                                          &mo 3      &none       &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&kp TAB  &none       &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &tog 5                                                          &tog 7     &none       &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&kp ESC  &kp KP_DOT  &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &tog 6    &trans   &trans             &trans         &trans     &tog 8     &kp KP_DOT  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&none    &kp KP_N0   &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER                        &mo 5              &kp PAGE_UP                          &kp KP_N0   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&mo 2    &none       &kp KP_DOT  &kp LEFT      &kp RIGHT                      &kp BSPC  &kp DEL  &kp LG(ENTER)      &kp PAGE_DOWN  &kp ENTER  &kp SPACE              &kp UP      &kp DOWN      &kp KP_DOT     &none            &mo 2
            >;
        };

        fn-revert {
            display-name = "Fn";
            bindings = <
&kp F1      &kp F2                &kp F3                  &kp F4                          &kp F5                           &kp F6                 &kp LS(LG(SLASH))                                                              &mo 3              &kp F7              &kp F8                        &kp F9                          &kp F10          &kp F11              &kp F12
&none       &kp LS(LA(UP_ARROW))  &kp LS(LA(LEFT_ARROW))  &kp UP_ARROW                    &kp LS(LA(RIGHT_ARROW))          &kp LS(LA(LC(LG(G))))  &kp LC(UP_ARROW)                                                               &kp C_VOLUME_UP    &none               &none                         &kp UP_ARROW                    &none            &none                &none
&none       &kp LA(LEFT_ARROW)    &kp LEFT_ARROW          &kp DOWN_ARROW                  &kp RIGHT_ARROW                  &kp LA(RIGHT_ARROW)    &kp LG(SPACE)      &trans     &kp LEFT_CONTROL      &kp RIGHT_ALT  &trans      &kp C_VOLUME_DOWN  &kp LA(LEFT_ARROW)  &kp LEFT_ARROW                &kp DOWN_ARROW                  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)  &none
&kp LSHIFT  &kp LG(UP_ARROW)      &none                   &kp LG(SLASH)                   &kp LG(N)                        &kp LG(O)                                            &kp HOME              &kp PAGE_UP                                   &none               &none                         &none                           &none            &kp LA(LC(SPACE))    &kp RSHFT
&trans      &none                 &none                   &kp LA(LC(LS(LG(LEFT_ARROW))))  &kp LA(LC(LS(LG(RIGHT_ARROW))))                         &kp SPACE          &kp ENTER  &kp END               &kp PAGE_DOWN  &kp DELETE  &kp BACKSPACE                          &kp LA(LC(LS(LG(UP_ARROW))))  &kp LA(LC(LG(LS(DOWN_ARROW))))  &none            &none                &trans
            >;
        };

        mod-media {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                  &bt BT_SEL 4          &none                                                  &trans           &none              &kp LS(LA(LC(LG(N))))      &none           &none             &none       &none
&none           &none         &tog 4        &none         &kp LS(LA(C_BRIGHTNESS_INC))  &kp C_BRIGHTNESS_INC  &bootloader                                            &bootloader      &kp C_VOLUME_UP    &kp LS(LA(C_VOLUME_UP))    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &none
&studio_unlock  &none         &none         &none         &kp LS(LA(C_BRIGHTNESS_DEC))  &kp C_BRIGHTNESS_DEC  &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &kp C_VOLUME_DOWN  &kp LS(LA(C_VOLUME_DOWN))  &none           &none             &none       &none
&none           &none         &none         &none         &macro_ver                    &none                                     &none      &none                                    &none              &kp K_MUTE                 &none           &none             &none       &none
&none           &none         &none         &none         &none                                               &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                     &bl BL_INC                 &bl BL_DEC      &none             &none       &none
            >;
        };

        windows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RIGHT_WIN  &kp RIGHT_CONTROL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans            &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans            &trans            &trans         &trans             &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        control-1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        arrows-2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        vscode-3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        xcode-4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
