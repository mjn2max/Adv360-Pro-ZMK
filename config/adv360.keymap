#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                           &tog 3     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 4                                                                           &tog 6     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &tog 5    &kp LEFT_GUI  &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &tog 7     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                           &mo 4              &kp PAGE_UP                                      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL       &kp LG(ENTER)      &kp PAGE_DOWN      &kp ENTER          &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none    &to 0       &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &trans                                                          &mo 3      &none       &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&kp TAB  &none       &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &tog 4                                                          &tog 6     &none       &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&kp ESC  &kp KP_DOT  &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &tog 5    &trans   &trans             &trans         &trans     &tog 7     &kp KP_DOT  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&none    &kp KP_N0   &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER                        &mo 4              &kp PAGE_UP                          &kp KP_N0   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&mo 2    &none       &kp KP_DOT  &kp LEFT      &kp RIGHT                      &kp BSPC  &kp DEL  &kp LG(ENTER)      &kp PAGE_DOWN  &kp ENTER  &kp SPACE              &kp UP      &kp DOWN      &kp KP_DOT     &none            &mo 2
            >;
        };

        fn-revert {
            display-name = "Fn";
            bindings = <
&kp F1      &kp F2                &kp F3                  &kp F4                          &kp F5                           &kp F6                 &kp LS(LG(SLASH))                                                                            &kp C_PLAY_PAUSE   &kp F7              &kp F8                        &kp F9                          &kp F10          &kp F11              &kp F12
&none       &kp LS(LA(UP_ARROW))  &kp LS(LA(LEFT_ARROW))  &kp UP_ARROW                    &kp LS(LA(RIGHT_ARROW))          &kp LS(LA(LC(LG(G))))  &kp LC(UP_ARROW)                                                                             &kp C_VOLUME_UP    &none               &none                         &kp UP_ARROW                    &none            &none                &none
&none       &kp LA(LEFT_ARROW)    &kp LEFT_ARROW          &kp DOWN_ARROW                  &kp RIGHT_ARROW                  &kp LA(RIGHT_ARROW)    &kp LG(SPACE)      &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_ALT  &kp RIGHT_COMMAND  &kp C_VOLUME_DOWN  &kp LA(LEFT_ARROW)  &kp LEFT_ARROW                &kp DOWN_ARROW                  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)  &none
&kp LSHIFT  &kp LG(UP_ARROW)      &none                   &kp LG(SLASH)                   &kp LG(N)                        &kp LG(O)                                                   &kp HOME              &kp PAGE_UP                                          &none               &none                         &none                           &none            &kp LA(LC(SPACE))    &kp RSHFT
&trans      &none                 &none                   &kp LA(LC(LS(LG(LEFT_ARROW))))  &kp LA(LC(LS(LG(RIGHT_ARROW))))                         &kp SPACE          &kp ENTER         &kp END               &kp PAGE_DOWN  &kp DELETE         &kp BACKSPACE                          &kp LA(LC(LS(LG(UP_ARROW))))  &kp LA(LC(LG(LS(DOWN_ARROW))))  &none            &none                &trans
            >;
        };

        mod-media {
            display-name = "Mod";
            bindings = <
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                  &bt BT_SEL 4          &none                                       &trans        &none              &kp LS(LA(LC(LG(N))))      &none           &none             &none       &none
&none       &none         &tog 8        &none         &kp LS(LA(C_BRIGHTNESS_INC))  &kp C_BRIGHTNESS_INC  &none                                       &none         &kp C_VOLUME_UP    &kp LS(LA(C_VOLUME_UP))    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &none
&bt BT_CLR  &none         &none         &none         &kp LS(LA(C_BRIGHTNESS_DEC))  &kp C_BRIGHTNESS_DEC  &none  &none  &none      &none  &none       &stp STP_BAT  &kp C_VOLUME_DOWN  &kp LS(LA(C_VOLUME_DOWN))  &none           &none             &none       &none
&none       &none         &none         &none         &macro_ver                    &none                               &none      &none                            &none              &kp K_MUTE                 &none           &none             &none       &none
&none       &none         &none         &none         &none                                               &none  &none  &none      &none  &bl BL_TOG  &none                            &bl BL_INC                 &bl BL_DEC      &none             &none       &none
            >;
        };

        controls-1 {
            bindings = <
&kp LG(GRAVE)  &to 0          &none                     &kp LC(UP_ARROW)          &kp LG(SPACE)              &kp LG(LS(SLASH))      &tog 1                                                                                    &tog 3     &none                  &none          &none         &none          &none          &kp F11
&kp LC(F4)     &kp Q          &kp LG(W)                 &kp LS(LA(LC(LG(UP))))    &kp LG(ENTER)              &kp LS(LA(LC(LG(G))))  &trans                                                                                    &tog 6     &kp LS(LA(LC(LG(G))))  &kp LG(ENTER)  &kp UP        &kp LC(ENTER)  &none          &kp LC(LEFT)
&kp ESCAPE     &kp LG(A)      &kp LS(LA(LC(LG(LEFT))))  &kp LS(LA(LC(LG(DOWN))))  &kp LS(LA(LC(LG(RIGHT))))  &kp LC(DOWN)           &tog 5         &kp LEFT_COMMAND  &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &tog 7     &kp LC(DOWN)           &kp LEFT       &kp DOWN      &kp RIGHT      &none          &kp LC(RIGHT)
&kp LSHIFT     &kp LG(Z)      &kp LG(X)                 &kp LG(C)                 &kp LG(V)                  &kp LG(M)                                               &kp LC(F4)         &kp PAGE_UP                                      &kp LG(N)              &kp LG(M)      &kp LC(LEFT)  &kp LC(RIGHT)  &kp LG(SLASH)  &kp RIGHT_SHIFT
&trans         &kp LG(GRAVE)  &none                     &none                     &none                                             &kp BACKSPACE  &kp DELETE        &kp LG(ENTER)      &kp PAGE_DOWN      &kp ENTER          &kp SPACE                         &none          &none         &none          &none          &trans
            >;
        };

        arrows-2 {
            bindings = <
&trans  &to 0   &trans  &trans  &trans  &trans  &tog 1                                      &tog 3  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &tog 4                                      &tog 6  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &tog 7  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        vscode-3 {
            bindings = <
&trans  &to 0   &trans  &trans  &trans  &trans  &tog 1                                      &tog 3  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &tog 4                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &tog 5  &trans  &trans      &trans  &trans  &tog 7  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        xcode-4 {
            bindings = <
&trans  &to 0   &trans  &trans  &trans  &trans  &tog 1                                      &tog 3  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &tog 4                                      &tog 6  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &tog 5  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        windows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RIGHT_WIN  &kp RIGHT_CONTROL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans            &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans            &trans            &trans         &trans             &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
