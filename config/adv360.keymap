#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hold_to_tap_kp: hold_to_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TO_TAP_KP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&to>, <&kp>;
        };

        hold_kp_tap_kp: hold_kp_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_KP_TAP_KP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hold_mo_tap_kp: hold_mo_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MO_TAP_KP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        vscode_markdown_preview: vscode_markdown_preview {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp V>;

            label = "VSCODE_MARKDOWN_PREVIEW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &hold_to_tap_kp 8 N2  &hold_to_tap_kp 7 N3  &hold_to_tap_kp 1 N4  &hold_to_tap_kp 2 N5  &tog 3                                                                                                  &tog 4             &hold_kp_tap_kp LG(LC(LA(LS(C)))) N6  &hold_kp_tap_kp LG(LC(LA(LS(N)))) N7  &hold_to_tap_kp 3 N8  &hold_to_tap_kp 5 N9  &hold_to_tap_kp 6 N0  &kp MINUS
&kp TAB    &kp Q      &kp W                 &kp E                 &kp R                 &kp T                 &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &kp Y                                 &kp U                                 &kp I                 &kp O                 &kp P                 &kp BSLH
&kp ESC    &kp A      &kp S                 &kp D                 &kp F                 &kp G                 &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &kp H                                 &kp J                                 &kp K                 &kp L                 &kp SEMI              &kp SQT
&kp LSHFT  &kp Z      &kp X                 &kp C                 &kp V                 &kp B                                                          &kp LC(F4)         &kp PAGE_UP                                                    &kp N                                 &kp M                                 &kp COMMA             &kp DOT               &kp FSLH              &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS              &kp LEFT              &kp RIGHT                                   &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE                                                &kp UP                                &kp DOWN              &kp LBKT              &kp RBKT              &mo 9
            >;
        };

        vscode_4 {
            bindings = <
&none       &to 0      &to 8      &to 7          &none          &to 2          &tog 3                                                                                                  &tog 4             &kp LS(LA(LC(LG(C))))     &kp LS(LA(LC(LG(N))))  &to 3          &to 5     &to 6          &none
&kp TAB     &kp Q      &kp LG(W)  &kp LG(LS(E))  &kp LG(ENTER)  &kp LG(GRAVE)  &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &kp LS(LG(V))             &kp LG(ENTER)          &kp LG(LC(I))  &none     &kp LG(LS(P))  &none
&kp ESC     &kp LG(A)  &kp LG(S)  &kp LG(D)      &kp LG(LS(F))  &kp LG(G)      &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &vscode_markdown_preview  &kp LS(LG(R))          &none          &none     &none          &none
&kp LSHIFT  &kp LG(Z)  &kp LG(X)  &kp LG(C)      &kp LG(V)      &kp F5                                                  &kp LC(F4)         &kp PAGE_UP                                                    &kp LG(N)                 &kp LG(LC(LS(M)))      &none          &none     &kp LG(SLASH)  &none
&mo 9       &kp GRAVE  &none      &kp LEFT       &kp RIGHT                     &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE                                    &kp UP                 &kp DOWN       &kp LBKT  &kp RBKT       &mo 9
            >;
        };

        xcode_5 {
            bindings = <
&none       &to 0              &to 8             &to 7             &to 1              &none                  &tog 3                                                                                                  &tog 4             &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(N))))  &to 3              &to 5          &to 6          &none
&kp TAB     &kp LG(LS(N2))     &kp LG(W)         &kp LG(LA(LBKT))  &kp LG(R)          &kp LG(LC(LA(LS(G))))  &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &kp LG(LA(LS(ENTER)))  &kp LG(U)              &kp LC(I)          &kp LG(LS(O))  &kp LG(LA(P))  &none
&kp ESC     &kp LG(LC(LS(A)))  &kp LG(LA(LEFT))  &kp LG(LA(RBKT))  &kp LG(LA(RIGHT))  &kp LG(LC(LA(LS(X))))  &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &kp LG(LA(ENTER))      &kp LG(LS(J))          &kp LG(LS(K))      &kp LG(LA(L))  &none          &none
&kp LSHIFT  &kp LG(Z)          &kp LG(LC(LEFT))  &kp LG(LS(Y))     &kp LG(LC(RIGHT))  &kp LG(B)                                                       &kp LC(F4)         &kp PAGE_UP                                                    &kp LG(LA(LC(ENTER)))  &kp LG(LC(LS(M)))      &kp LG(LA(COMMA))  &kp LG(DOT)    &kp LG(SLASH)  &kp RSHIFT
&mo 9       &kp GRAVE          &none             &kp LEFT          &kp RIGHT                                 &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE                                 &kp UP                 &kp DOWN           &kp LBKT       &kp RBKT       &mo 9
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none    &to 0       &hold_to_tap_kp 8 KP_NUM  &hold_to_tap_kp 7 KP_EQUAL  &hold_to_tap_kp 1 KP_SLASH  &hold_to_tap_kp 2 KP_MULTIPLY  &trans                                                                                                  &tog 4             &none       &kp KP_NUM  &kp KP_EQUAL  &hold_to_tap_kp 5 KP_SLASH  &hold_to_tap_kp 6 KP_MULTIPLY  &none
&kp TAB  &none       &kp KP_N7                 &kp KP_N8                   &kp KP_N9                   &kp KP_MINUS                   &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &none       &kp KP_N7   &kp KP_N8     &kp KP_N9                   &kp KP_MINUS                   &none
&kp ESC  &kp KP_DOT  &kp KP_N4                 &kp KP_N5                   &kp KP_N6                   &kp KP_PLUS                    &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &kp KP_DOT  &kp KP_N4   &kp KP_N5     &kp KP_N6                   &kp KP_PLUS                    &none
&none    &kp KP_N0   &kp KP_N1                 &kp KP_N2                   &kp KP_N3                   &kp KP_ENTER                                                            &kp LC(F4)         &kp PAGE_UP                                                    &kp KP_N0   &kp KP_N1   &kp KP_N2     &kp KP_N3                   &kp KP_ENTER                   &none
&mo 9    &none       &kp KP_DOT                &kp LEFT                    &kp RIGHT                                                  &kp BSPC       &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE                      &kp UP      &kp DOWN      &kp KP_DOT                  &none                          &mo 9
            >;
        };

        mod-media {
            display-name = "Mod";
            bindings = <
&none  &to 0  &to 8  &to 7       &to 1                         &to 2                 &tog 3                                                                                                  &trans        &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(N))))      &to 3           &to 5             &to 6       &bt BT_SEL 0
&none  &none  &none  &none       &kp LS(LA(C_BRIGHTNESS_INC))  &kp C_BRIGHTNESS_INC  &kp LC(UP)                                                                                              &none         &kp C_VOLUME_UP        &kp LS(LA(C_VOLUME_UP))    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &bt BT_SEL 1
&none  &none  &none  &none       &kp LS(LA(C_BRIGHTNESS_DEC))  &kp C_BRIGHTNESS_DEC  &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &stp STP_BAT  &kp C_VOLUME_DOWN      &kp LS(LA(C_VOLUME_DOWN))  &none           &none             &none       &bt BT_SEL 2
&none  &none  &none  &bt BT_CLR  &macro_ver                    &none                                                          &kp LC(F4)         &kp PAGE_UP                                               &none                  &kp K_MUTE                 &none           &none             &none       &bt BT_SEL 3
&mo 9  &none  &none  &kp LEFT    &kp RIGHT                                           &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE                            &bl BL_INC                 &bl BL_DEC      &bl BL_TOG        &none       &mo 9
            >;
        };

        android_9 {
            bindings = <
&none       &hold_to_tap_kp 0 F1  &hold_to_tap_kp 8 F2  &hold_to_tap_kp 7 F3  &hold_to_tap_kp 1 F4  &hold_to_tap_kp 2 F5  &tog 3                                                                                                  &tog 4     &kp F6  &kp F7  &hold_to_tap_kp 3 F8  &kp F9  &hold_to_tap_kp 6 F10  &kp F11
&kp TAB     &kp Q                 &kp W                 &none                 &none                 &none                 &none                                                                                                   &none      &none   &none   &none                 &none   &none                  &kp F12
&kp ESC     &none                 &none                 &none                 &none                 &none                 &none          &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &none      &none   &none   &none                 &none   &none                  &none
&kp LSHIFT  &kp Z                 &none                 &none                 &none                 &none                                                          &kp LC(F4)         &kp PAGE_UP                                            &none   &none   &none                 &none   &none                  &kp RSHIFT
&mo 9       &none                 &none                 &none                 &none                                       &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(SPACE)      &kp PAGE_DOWN      &hold_mo_tap_kp 7 ENTER  &kp SPACE          &none   &none                 &none   &none                  &mo 9
            >;
        };

        windows_10 {
            bindings = <
&trans  &hold_to_tap_kp 0 N1  &trans  &trans    &trans     &trans  &tog 3                                                                                             &tog 4             &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans                &trans  &trans    &trans     &trans  &kp LC(UP)                                                                                         &kp C_VOLUME_UP    &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans                &trans  &trans    &trans     &trans  &kp LG(SPACE)  &kp LEFT_CONTROL          &kp LEFT_ALT      &kp RIGHT_WIN  &kp RIGHT_CONTROL        &kp C_VOLUME_DOWN  &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans                &trans  &trans    &trans     &trans                                           &kp HOME          &kp PAGE_UP                                                &trans  &trans  &trans    &trans  &trans  &trans
&mo 9   &trans                &trans  &kp LEFT  &kp RIGHT          &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp END           &kp PAGE_DOWN  &hold_mo_tap_kp 7 ENTER  &kp SPACE                  &kp UP  &kp DOWN  &trans  &trans  &mo 9
            >;
        };

        arrows_3 {
            bindings = <
&none       &to 0           &to 8             &none          &to 1              &to 2                  &tog 3                                                                                                  &tog 4             &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(N))))  &to 3     &to 5      &to 6              &none
&kp TAB     &kp LS(LA(UP))  &kp LS(LA(LEFT))  &kp UP         &kp LS(LA(RIGHT))  &kp LS(LA(LG(LC(G))))  &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &none                  &none                  &kp UP    &none      &none              &none
&kp ESC     &kp LA(LEFT)    &kp LEFT          &kp DOWN       &kp RIGHT          &kp LA(RIGHT)          &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &kp LA(LEFT)           &kp LEFT               &kp DOWN  &kp RIGHT  &kp LA(RIGHT)      &none
&kp LSHIFT  &kp LG(Z)       &none             &kp LG(SLASH)  &kp LG(N)          &kp LG(O)                                                       &kp LC(F4)         &kp PAGE_UP                                                    &none                  &none                  &none     &none      &kp LC(LG(SPACE))  &kp RSHIFT
&mo 9       &none           &none             &kp LEFT       &kp RIGHT                                 &kp BACKSPACE  &hold_mo_tap_kp 8 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_to_tap_kp 0 ENTER  &kp SPACE                                 &kp UP                 &kp DOWN  &none      &none              &mo 9
            >;
        };

        controls_2 {
            bindings = <
&kp LG(GRAVE)  &to 0          &none                     &to 7                     &to 1                      &to 2                  &tog 3                                                                                                  &tog 4             &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(N))))  &to 3         &to 5          &to 6          &kp F11
&kp LC(F4)     &kp Q          &kp LG(W)                 &kp LS(LA(LC(LG(UP))))    &kp LG(ENTER)              &kp LS(LA(LC(LG(G))))  &kp LC(UP)                                                                                              &kp C_VOLUME_UP    &kp LS(LA(LC(LG(G))))  &kp LG(ENTER)          &kp UP        &kp LC(ENTER)  &none          &kp LC(LEFT)
&kp ESCAPE     &kp LG(A)      &kp LS(LA(LC(LG(LEFT))))  &kp LS(LA(LC(LG(DOWN))))  &kp LS(LA(LC(LG(RIGHT))))  &kp LC(DOWN)           &kp LG(SPACE)  &kp LEFT_COMMAND          &kp LEFT_ALT       &kp RIGHT_CONTROL  &kp RIGHT_COMMAND        &kp C_VOLUME_DOWN  &kp LC(DOWN)           &kp LEFT               &kp DOWN      &kp RIGHT      &none          &kp LC(RIGHT)
&kp LSHIFT     &kp LG(Z)      &kp LG(X)                 &kp LG(C)                 &kp LG(V)                  &kp LG(M)                                                       &kp LC(F4)         &kp PAGE_UP                                                    &kp LG(N)              &kp LG(M)              &kp LC(LEFT)  &kp LC(RIGHT)  &kp LG(SLASH)  &kp RIGHT_SHIFT
&mo 9          &kp LG(GRAVE)  &none                     &kp LEFT                  &kp RIGHT                                         &kp BACKSPACE  &hold_to_tap_kp 0 DELETE  &kp LG(ENTER)      &kp PAGE_DOWN      &hold_to_tap_kp 0 ENTER  &kp SPACE                                 &kp UP                 &kp DOWN      &none          &none          &mo 9
            >;
        };

        fn_revert_7 {
            display-name = "Fn";
            bindings = <
&kp F1      &kp F2                &kp F3                  &kp F4                          &kp F5                           &kp F6                 &kp LS(LG(SLASH))                                                                            &kp C_PLAY_PAUSE   &kp F7              &kp F8                        &kp F9                          &kp F10          &kp F11              &kp F12
&none       &kp LS(LA(UP_ARROW))  &kp LS(LA(LEFT_ARROW))  &kp UP_ARROW                    &kp LS(LA(RIGHT_ARROW))          &kp LS(LA(LC(LG(G))))  &kp LC(UP_ARROW)                                                                             &kp C_VOLUME_UP    &none               &none                         &kp UP_ARROW                    &none            &none                &none
&none       &kp LA(LEFT_ARROW)    &kp LEFT_ARROW          &kp DOWN_ARROW                  &kp RIGHT_ARROW                  &kp LA(RIGHT_ARROW)    &kp LG(SPACE)      &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_ALT  &kp RIGHT_COMMAND  &kp C_VOLUME_DOWN  &kp LA(LEFT_ARROW)  &kp LEFT_ARROW                &kp DOWN_ARROW                  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)  &none
&kp LSHIFT  &kp LG(UP_ARROW)      &none                   &kp LG(SLASH)                   &kp LG(N)                        &kp LG(O)                                                   &kp HOME              &kp PAGE_UP                                          &none               &none                         &none                           &none            &kp LC(LG(SPACE))    &kp RSHFT
&trans      &none                 &none                   &kp LA(LC(LS(LG(LEFT_ARROW))))  &kp LA(LC(LS(LG(RIGHT_ARROW))))                         &kp SPACE          &kp ENTER         &kp END               &kp PAGE_DOWN  &kp DELETE         &kp BACKSPACE                          &kp LA(LC(LS(LG(UP_ARROW))))  &kp LA(LC(LG(LS(DOWN_ARROW))))  &none            &none                &trans
            >;
        };
    };
};
